{
  "info": {
    "name": "Funcionarios API - MVP",
    "description": "Colecao de testes da API REST de gerenciamento de funcionarios (Node.js + Express).\n\nCenarios cobertos:\n1. Criacao com sucesso (201)\n2. Falha na criacao por validacao (400)\n3. Listagem geral (200)\n4. Falha na busca por ID inexistente (404)\n5. Atualizacao (200)\n6. Remocao (200)\n\nAntes de rodar: suba o servidor com 'npm run dev' na pasta do projeto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "novoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Criacao com sucesso (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Resposta usa o envelope \"data\"', function () {",
              "    pm.expect(pm.response.json()).to.have.property('data');",
              "});",
              "",
              "pm.test('O recurso criado recebeu um id', function () {",
              "    pm.expect(pm.response.json().data).to.have.property('id');",
              "});",
              "",
              "pm.test('Os dados enviados foram persistidos', function () {",
              "    var d = pm.response.json().data;",
              "    pm.expect(d.nome).to.eql('Elis Regina');",
              "    pm.expect(d.salario).to.eql(4800);",
              "});",
              "",
              "// Guarda o id para as requisicoes seguintes",
              "pm.collectionVariables.set('novoId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Elis Regina\",\n  \"cargo\": \"Analista\",\n  \"salario\": 4800,\n  \"departamento\": \"RH\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/funcionarios", "host": ["{{baseUrl}}"], "path": ["funcionarios"] },
        "description": "Caminho feliz: payload completo e valido. Espera 201 Created com o header Location."
      }
    },
    {
      "name": "2. Falha na criacao - campo ausente (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Resposta usa o envelope \"error\"', function () {",
              "    pm.expect(pm.response.json()).to.have.property('error');",
              "});",
              "",
              "pm.test('O erro aponta o campo ausente', function () {",
              "    var campos = pm.response.json().error.details.map(function (d) { return d.field; });",
              "    pm.expect(campos).to.include('departamento');",
              "});",
              "",
              "pm.test('Nenhum recurso foi criado', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('data');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Joao Sem Departamento\",\n  \"cargo\": \"Estagiario\",\n  \"salario\": 1500\n}"
        },
        "url": { "raw": "{{baseUrl}}/funcionarios", "host": ["{{baseUrl}}"], "path": ["funcionarios"] },
        "description": "Falha intencional: o campo obrigatorio 'departamento' foi omitido. Espera 400 com details apontando o campo."
      }
    },
    {
      "name": "3. Listagem geral (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type e application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('data e um array', function () {",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});",
              "",
              "pm.test('A lista contem ao menos os 5 registros iniciais', function () {",
              "    pm.expect(pm.response.json().data.length).to.be.at.least(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/funcionarios", "host": ["{{baseUrl}}"], "path": ["funcionarios"] },
        "description": "Listagem da colecao completa. Espera 200 OK com um array dentro de 'data'."
      }
    },
    {
      "name": "4. Falha na busca - ID inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Resposta usa o envelope \"error\"', function () {",
              "    pm.expect(pm.response.json()).to.have.property('error');",
              "});",
              "",
              "pm.test('A resposta e JSON, nao HTML', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('A mensagem informa o id procurado', function () {",
              "    pm.expect(pm.response.json().error.message).to.include('999');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/funcionarios/999", "host": ["{{baseUrl}}"], "path": ["funcionarios", "999"] },
        "description": "Busca por um ID que comprovadamente nao existe na estrutura em memoria. Espera 404 com mensagem JSON."
      }
    },
    {
      "name": "5. Extra - Atualizacao do registro criado (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('O salario foi atualizado', function () {",
              "    pm.expect(pm.response.json().data.salario).to.eql(5600);",
              "});",
              "",
              "pm.test('O id permaneceu imutavel', function () {",
              "    pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('novoId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Elis Regina\",\n  \"cargo\": \"Analista Senior\",\n  \"salario\": 5600,\n  \"departamento\": \"RH\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/funcionarios/{{novoId}}", "host": ["{{baseUrl}}"], "path": ["funcionarios", "{{novoId}}"] },
        "description": "Atualiza o funcionario criado no cenario 1, usando o id guardado na variavel de colecao."
      }
    },
    {
      "name": "6. Extra - Remocao do registro criado (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status e 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('O registro removido foi devolvido', function () {",
              "    pm.expect(pm.response.json().data).to.have.property('nome');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/funcionarios/{{novoId}}", "host": ["{{baseUrl}}"], "path": ["funcionarios", "{{novoId}}"] },
        "description": "Remove o funcionario criado. Rodar duas vezes demonstra 200 seguido de 404."
      }
    }
  ]
}
